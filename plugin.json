{
  "tesserae_compat": "1.x",
  "name": "Tonight's Sky",
  "version": "0.1.1",
  "kind": "widget",
  "description": "An all-sky chart of what is actually above you right now: 5,000 stars, constellation figures, the planets and the Moon with its true phase. Computed on the spot from a built-in catalogue, so it needs no API key and makes no network call.",
  "icon": "ph-star-four",
  "supports": {
    "sizes": [
      "xs",
      "sm",
      "md",
      "lg"
    ]
  },
  "render": {
    "needs_network": false
  },
  "cell_options": [
    {
      "name": "location",
      "type": "location_search",
      "label": "Location",
      "help": "Whose sky to draw. Falls back to the app-level location in Settings when empty.",
      "default": ""
    },
    {
      "name": "when",
      "type": "select",
      "label": "Time",
      "default": "now",
      "help": "Now follows the real sky through the night. A fixed hour gives the same view every evening.",
      "choices": [
        {
          "value": "now",
          "label": "Now"
        },
        {
          "value": "20",
          "label": "8 pm tonight"
        },
        {
          "value": "21",
          "label": "9 pm tonight"
        },
        {
          "value": "22",
          "label": "10 pm tonight"
        },
        {
          "value": "23",
          "label": "11 pm tonight"
        }
      ]
    },
    {
      "name": "layout",
      "type": "select",
      "label": "Layout",
      "default": "board",
      "help": "Full bleed fills the whole cell with sky and drops every label — good as a wallpaper.",
      "choices": [
        {
          "value": "board",
          "label": "Chart and readout"
        },
        {
          "value": "chart",
          "label": "Chart only"
        },
        {
          "value": "bleed",
          "label": "Full bleed — no text"
        }
      ]
    },
    {
      "name": "theme",
      "type": "select",
      "label": "Theme",
      "default": "chart",
      "choices": [
        {
          "value": "chart",
          "label": "Chart — black on white"
        },
        {
          "value": "night",
          "label": "Night — white on black"
        },
        {
          "value": "blueprint",
          "label": "Blueprint — pale on deep blue"
        }
      ]
    },
    {
      "name": "mag",
      "type": "select",
      "label": "Faintest stars shown",
      "default": "5.0",
      "help": "Higher shows more stars. On a small panel 4.5 stays legible; 6.0 is roughly the naked-eye limit.",
      "choices": [
        {
          "value": "4.0",
          "label": "Mag 4.0 — bright only"
        },
        {
          "value": "4.5",
          "label": "Mag 4.5"
        },
        {
          "value": "5.0",
          "label": "Mag 5.0"
        },
        {
          "value": "5.5",
          "label": "Mag 5.5"
        },
        {
          "value": "6.0",
          "label": "Mag 6.0 — naked-eye limit"
        }
      ]
    },
    {
      "name": "show_lines",
      "type": "boolean",
      "label": "Draw constellation figures",
      "default": true
    },
    {
      "name": "show_labels",
      "type": "boolean",
      "label": "Name the constellations",
      "default": true
    },
    {
      "name": "show_star_names",
      "type": "boolean",
      "label": "Name the brightest stars",
      "default": true
    },
    {
      "name": "show_planets",
      "type": "boolean",
      "label": "Mark the planets",
      "default": true
    }
  ],
  "fragments": [
    {
      "id": "full",
      "label": "Chart and readout",
      "w": 420,
      "h": 240,
      "icon": "ph-star-four"
    },
    {
      "id": "chart",
      "label": "Chart only",
      "w": 240,
      "h": 240,
      "icon": "ph-circle"
    },
    {
      "id": "bleed",
      "label": "Full bleed — no text",
      "w": 320,
      "h": 200,
      "icon": "ph-sparkle"
    }
  ],
  "data_schema": {
    "fields": [
      {
        "name": "label",
        "type": "str",
        "label": "Location"
      },
      {
        "name": "time",
        "type": "str",
        "label": "Chart time"
      },
      {
        "name": "twilight",
        "type": "str",
        "label": "Sky state"
      },
      {
        "name": "sun_alt",
        "type": "num",
        "label": "Sun altitude (deg)"
      },
      {
        "name": "moon_phase",
        "type": "str",
        "label": "Moon phase"
      },
      {
        "name": "moon_illum",
        "type": "num",
        "label": "Moon illuminated (%)"
      },
      {
        "name": "star_count",
        "type": "num",
        "label": "Stars above horizon"
      },
      {
        "name": "planets_up",
        "type": "num",
        "label": "Naked-eye planets up"
      },
      {
        "name": "planet_list",
        "type": "str",
        "label": "Planets up"
      }
    ],
